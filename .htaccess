Options -Indexes

# Приховані файли (.git, .env, .htaccess тощо)
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Увімкніть після того, як переконаєтесь, що сайт повністю працює через HTTPS:
  # Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Ліміти завантаження (діє для mod_php; на PHP-FPM задайте те саме у .user.ini)
<IfModule mod_php.c>
  php_value upload_max_filesize 10M
  php_value post_max_size 55M
  php_value max_file_uploads 6
</IfModule>
